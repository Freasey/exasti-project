# Connection string Neon Postgres
DATABASE_URL=

# Kunci penandatangan cookie sesi (mis. `openssl rand -base64 32`)
AUTH_SECRET=

# Token Vercel Blob store. Opsional saat development:
# tanpa ini, arsip track penuh & unggah foto profil dinonaktifkan.
# Kode menargetkan store dengan akses `private` (lihat src/lib/blob.ts).
BLOB_READ_WRITE_TOKEN=

# API key OpenRouteService untuk fitur Green Route (rute sepeda A->B).
# Gratis, daftar di https://openrouteservice.org - tanpa ini layer jalur
# sepeda tetap jalan, hanya perencanaan rute yang dinonaktifkan.
ORS_API_KEY=

# API key gratis CARTO untuk basemap peta (dark_all). Daftar di
# https://carto.com/basemaps/apikey - tanpa ini tile peta tetap tampil,
# hanya ditandai watermark "API KEY REQUIRED".
NEXT_PUBLIC_CARTO_API_KEY=
