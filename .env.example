# Connection string Neon Postgres
DATABASE_URL=

# Kunci penandatangan cookie sesi (mis. `openssl rand -base64 32`)
AUTH_SECRET=

# Token Vercel Blob store. Opsional saat development:
# tanpa ini, arsip track penuh & unggah foto profil dinonaktifkan.
# Kode menargetkan store dengan akses `private` (lihat src/lib/blob.ts).
BLOB_READ_WRITE_TOKEN=
